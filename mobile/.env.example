# Endereco da API. Tem prioridade sobre app.json -> expo.extra.
# Com ngrok/https: coloque o host com https:// (a porta e ignorada)
EXPO_PUBLIC_API_HOST=https://SEU-SUBDOMINIO.ngrok-free.dev
EXPO_PUBLIC_API_PORT=443

# Rede local (celular e PC no mesmo Wi-Fi): use o IP do PC e a porta da API
# EXPO_PUBLIC_API_HOST=192.168.0.10
# EXPO_PUBLIC_API_PORT=3333
